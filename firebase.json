{
  "hosting": [
    {
      "target": "principal",
      "public": "public",
      "cleanUrls": true,
      "trailingSlash": true,
      "redirects": [
        {
          "source": "/juego{,/**}",
          "destination": "/el-juego/",
          "type": 301
        },
        {
          "source": "/asistentes{,/**}",
          "destination": "/cronista/",
          "type": 301
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(css|js|woff2|webp|avif|jpg|png|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    }
  ]
}
